: dir_string ! Do not change the order of the enumerators ! It is clockwise enum , bind ( c ) enumerator :: EAST = 1 enumerator :: SOUTH enumerator :: WEST enumerator :: NORTH end enum integer , parameter :: N_DIR = 4 contains integer function reverse ( dir ) integer , intent ( in ) :: dir reverse = 1 + mod ( dir - 1 + 2 , N_DIR ) end function reverse integer function next_direction ( dir ) integer , intent ( in ) :: dir next_direction = 1 + mod ( dir - 1 + 1 , N_DIR ) end function next_direction function dir_string ( dir ) result ( s ) character ( 1 ) :: s integer , intent ( in ) :: dir select case ( dir ) case ( EAST ) s = 'E' case ( SOUTH ) s = 'S' case ( WEST ) s = 'W' case ( NORTH ) s = 'N' end select end function dir_string end module mapl_Direction_mod","tags":"","url":"sourcefile/direction.f90.html"},{"title":"FortranTimerGauge.F90 – MAPL","text":"This file depends on sourcefile~~fortrantimergauge.f90~~EfferentGraph sourcefile~fortrantimergauge.f90 FortranTimerGauge.F90 sourcefile~abstractgauge.f90 AbstractGauge.F90 sourcefile~fortrantimergauge.f90->sourcefile~abstractgauge.f90 sourcefile~abstractmeter.f90 AbstractMeter.F90 sourcefile~abstractgauge.f90->sourcefile~abstractmeter.f90 sourcefile~errorhandling.f90 ErrorHandling.F90 sourcefile~abstractmeter.f90->sourcefile~errorhandling.f90 sourcefile~mapl_throw.f90 MAPL_Throw.F90 sourcefile~errorhandling.f90->sourcefile~mapl_throw.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~fortrantimergauge.f90~~AfferentGraph sourcefile~fortrantimergauge.f90 FortranTimerGauge.F90 sourcefile~mapl_profiler.f90 MAPL_Profiler