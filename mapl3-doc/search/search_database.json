"},{"title":"mapl_MeterNodeVector_mod – MAPL","text":"$   public :: foreach $   ! =======================\n$   !  insert\n$   ! =======================\n$   subroutine vector_insert_size_kind(                                                 &\n$        &   this, index, value, unused, rc)\n$      class(MeterNodeVector), target, intent(inout) :: this\n$\n$      integer(kind=GFTL_SIZE_KIND), intent(in) :: index\n$\n$      class(AbstractMeterNode), intent(in) :: value\n$      type (KeywordEnforcer), optional, intent(in) :: unused\n$      integer, optional, intent(out) :: rc\n$\n$      class(AbstractMeterNode), allocatable :: temp\n$      integer(kind=GFTL_SIZE_KIND) :: i, n\n$\n$      if (.false.) print*,shape(unused)\n$\n$      n = this%vsize\n$      if (index==n+1) then\n$         call this%push_back(value)\n$         ! Workaround for NAG -6221 - temp needs some status\n$         allocate(temp, source=value)\n$         return\n$      endif\n$      call this%grow_to(this%vsize+1)\n$      allocate(temp, source=this%elements(n)%item)\n$      call this%resize(n+1, temp, rc=rc)\n$\n$      do i = n, index, -1\n$         call move_alloc(from=this%elements(index-1)%item,to=this%elements(index)%item)\n$      end do\n$\n$      allocate(this%elements(index)%item, source=value)\n$\n$      return\n$   end subroutine vector_insert_size_kind\n$\n$\n$   subroutine vector_insert_default(this, index, value)\n$      class(MeterNodeVector), intent(inout) :: this\n$      integer, intent(in) :: index\n$      class(AbstractMeterNode), intent(in) :: value\n$\n$      call this%insert(int(index,kind=GFTL_SIZE_KIND), value)\n$   end subroutine vector_insert_default Uses mapl_AbstractMeterNode_mod module~~mapl_meternodevector_mod~~UsesGraph module~mapl_meternodevector_mod mapl_MeterNodeVector_mod module~mapl_abstractmeternode_mod mapl_AbstractMeterNode_mod module~mapl_meternodevector_mod->module~mapl_abstractmeternode_mod module~mapl_abstractmeter_mod mapl_AbstractMeter_mod module~mapl_abstractm