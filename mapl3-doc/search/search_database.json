-separated field names logical, intent(in), optional :: strict error if only_vars name not found character(len=*), intent(in), optional :: name Return Value type( MAPL_SimpleBundle ) private  function MAPL_SimpleBundleCreateFromState(State, rc, Levs, LevUnits, ptop, delp, only_vars, strict, name) result(self) Given an ESMF State, creates a corresponding Simple Bundle.\nIt is assumed that the ESMF State has a single grid. Arguments Type Intent Optional Attributes Name type( ESMF_State ), intent(inout), target :: State integer, intent(out), optional :: rc real(kind=ESMF_KIND_R4), intent(in), optional :: Levs (:) character(len=*), intent(in), optional :: LevUnits real(kind=ESMF_KIND_R4), intent(in), optional :: ptop real(kind=ESMF_KIND_R4), intent(in), optional, pointer :: delp (:,:,:) character(len=*), intent(in), optional :: only_vars logical, intent(in), optional :: strict character(len=*), intent(in), optional :: name Return Value type( MAPL_SimpleBundle )","tags":"","url":"interface/mapl_simplebundlecreate.html"},{"title":"FieldAXPY – MAPL","text":"public interface FieldAXPY Module Procedures private  subroutine axpy_r4(a, x, y, rc) Arguments Type Intent Optional Attributes Name real(kind=ESMF_KIND_R4), intent(in) :: a type( ESMF_Field ), intent(inout) :: x type( ESMF_Field ), intent(inout) :: y integer, intent(out), optional :: rc private  subroutine axpy_r8(a, x, y, rc) Arguments Type Intent Optional Attributes Name real(kind=ESMF_KIND_R8), intent(in) :: a type( ESMF_Field ), intent(inout) :: x type( ESMF_Field ), intent(inout) :: y integer, intent(out), optional :: rc","tags":"","url":"interface/fieldaxpy.html"},{"title":"FieldConvertPrec – MAPL","text":"public interface FieldConvertPrec Module Procedures private  subroutine convert_prec(x, y, rc) Arguments Type Intent Optional Attributes Name type( ESMF_Field ), intent(inout) :: x type( ESMF_Field ), intent(inout) :: y integer, intent(out), optional :: rc","tags":"","url":"interface/fieldconvertprec.html"},{"t