ive message' ) if ( uDIM == 1 ) then call QSORTS ( A , B , size ( A ), - size ( B , 2 )) else call QSORTS ( A , B , size ( A ), size ( B , 1 )) end if end subroutine SORT2SR subroutine SORT2SD ( A , B , DIM ) integer ( kind = INT32 ), intent ( INOUT ) :: A (:) real ( kind = REAL64 ), intent ( INOUT ) :: B (:,:) integer , optional , intent ( IN ) :: DIM integer :: uDIM , rc if ( present ( DIM )) then uDIM = DIM else uDIM = 2 end if _ ASSERT ( uDIM > 0 , 'uDim needs to be greater than 0' ) _ ASSERT ( uDIM < 3 , 'uDim needs to be less than 3' ) _ ASSERT ( size ( A ) == size ( B , uDIM ), 'needs informative message' ) if ( uDIM == 1 ) then call QSORTS ( A , B , size ( A ), - size ( B , 2 ) * 2 ) else call QSORTS ( A , B , size ( A ), size ( B , 1 ) * 2 ) end if end subroutine SORT2SD subroutine SORT2LS ( A , B , DIM ) integer ( kind = INT64 ), intent ( INOUT ) :: A (:) integer ( kind = INT32 ), intent ( INOUT ) :: B (:,:) integer , optional , intent ( IN ) :: DIM integer :: uDIM , rc if ( present ( DIM )) then uDIM = DIM else uDIM = 2 end if _ ASSERT ( uDIM > 0 , 'uDim needs to be greater than 0' ) _ ASSERT ( uDIM < 3 , 'uDim needs to be less than 3' ) _ ASSERT ( size ( A ) == size ( B , uDIM ), 'needs informative message' ) if ( uDIM == 1 ) then call QSORTL ( A , B , size ( A ), - size ( B , 2 )) else call QSORTL ( A , B , size ( A ), size ( B , 1 )) end if end subroutine SORT2LS subroutine SORT2LR ( A , B , DIM ) integer ( kind = INT64 ), intent ( INOUT ) :: A (:) real ( kind = REAL32 ), intent ( INOUT ) :: B (:,:) integer , optional , intent ( IN ) :: DIM integer :: uDIM , rc if ( present ( DIM )) then uDIM = DIM else uDIM = 2 end if _ ASSERT ( uDIM > 0 , 'uDim needs to be greater than 0' ) _ ASSERT ( uDIM < 3 , 'uDim needs to be less than 3' ) _ ASSERT ( size ( A ) == size ( B , uDIM ), 'needs informative message' ) if ( uDIM == 1 ) then call QSORTL ( A , B , size ( A ), - size ( B , 2 )) else call QSORTL ( A , B , size ( A ), size ( B , 1 )) end if end subroutine S