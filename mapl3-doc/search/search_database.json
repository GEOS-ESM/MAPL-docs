al geom type.\" ) end if _ RETURN ( ESMF_SUCCESS ) contains subroutine get_locstream_coords ( locstream , longitudes , latitudes , rc ) type ( ESMF_LocStream ), intent ( in ) :: locstream real ( kind = ESMF_KIND_R8 ), pointer :: longitudes (:) real ( kind = ESMF_KIND_R8 ), pointer :: latitudes (:) integer , optional , intent ( out ) :: rc integer :: status call ESMF_LocStreamGetKey ( locstream , keyName = 'ESMF:Lon' , farray = longitudes , _ RC ) call ESMF_LocStreamGetKey ( locstream , keyName = 'ESMF:Lat' , farray = latitudes , _ RC ) _ RETURN ( ESMF_SUCCESS ) end subroutine get_locstream_coords end subroutine MAPL_GeomGetCoords end submodule MAPL_GeomGetCoords_smod","tags":"","url":"sourcefile/mapl_geomgetcoords.f90.html"},{"title":"NetCDF4_FileFormatter.F90 – MAPL","text":"This file depends on sourcefile~~netcdf4_fileformatter.f90~~EfferentGraph sourcefile~netcdf4_fileformatter.f90 NetCDF4_FileFormatter.F90 sourcefile~attribute.f90 Attribute.F90 sourcefile~netcdf4_fileformatter.f90->sourcefile~attribute.f90 sourcefile~coordinatevariable.f90 CoordinateVariable.F90 sourcefile~netcdf4_fileformatter.f90->sourcefile~coordinatevariable.f90 sourcefile~errorhandling.f90 ErrorHandling.F90 sourcefile~netcdf4_fileformatter.f90->sourcefile~errorhandling.f90 sourcefile~filemetadata.f90 FileMetadata.F90 sourcefile~netcdf4_fileformatter.f90->sourcefile~filemetadata.f90 sourcefile~keywordenforcer.f90 KeywordEnforcer.F90 sourcefile~netcdf4_fileformatter.f90->sourcefile~keywordenforcer.f90 sourcefile~netcdf_supplement.f90 NetCDF_Supplement.F90 sourcefile~netcdf4_fileformatter.f90->sourcefile~netcdf_supplement.f90 sourcefile~pfio_constants.f90 pFIO_Constants.F90 sourcefile~netcdf4_fileformatter.f90->sourcefile~pfio_constants.f90 sourcefile~stringvariablemap.f90 StringVariableMap.F90 sourcefile~netcdf4_fileformatter.f90->sourcefile~stringvariablemap.f90 sourcefile~unlimitedentity.f90 UnlimitedEntity.F90 sourcefile~netcdf4_fileformatter.f90->sourcefile~unlimitedentity.f90 sourcefile~