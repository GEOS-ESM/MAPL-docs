ents if ( destroying_contents ) then call MAPL_FieldBundleGet ( bundle , fieldList = fieldList , _ RC ) call FieldsDestroy ( fieldList , _ RC ) end if call ESMF_FieldBundleGet ( bundle , name = name , _ RC ) call ESMF_FieldBundleDestroy ( bundle , _ RC ) call ESMF_FieldBundleValidate ( bundle , rc = status ) _ ASSERT ( status /= ESMF_SUCCESS , 'Bundle \"' // trim ( name ) // '\" was not destroyed.' ) _ RETURN ( _ SUCCESS ) _ UNUSED_DUMMY ( unusable ) end subroutine destroy_bundle end module mapl_FieldBundleDestroy_mod","tags":"","url":"sourcefile/fieldbundledestroy.f90.html"},{"title":"StringUtilities.F90 – MAPL","text":"This file depends on sourcefile~~stringutilities.f90~~EfferentGraph sourcefile~stringutilities.f90 StringUtilities.F90 sourcefile~keywordenforcer.f90 KeywordEnforcer.F90 sourcefile~stringutilities.f90->sourcefile~keywordenforcer.f90 Help Graph Key Nodes of different colours represent the following: Graph Key Source File Source File This Page's Entity This Page's Entity Solid arrows point from a file to a file which it depends on. A file\nis dependent upon another if the latter must be compiled before the former\ncan be. Where possible, edges connecting nodes are\ngiven different colours to make them easier to distinguish in\nlarge graphs. Files dependent on this one sourcefile~~stringutilities.f90~~AfferentGraph sourcefile~stringutilities.f90 StringUtilities.F90 sourcefile~api.f90~15 API.F90 sourcefile~api.f90~15->sourcefile~stringutilities.f90 sourcefile~string.f90 String.F90 sourcefile~api.f90~15->sourcefile~string.f90 sourcefile~componentspec.f90 ComponentSpec.F90 sourcefile~componentspec.f90->sourcefile~stringutilities.f90 sourcefile~locstreamgeomfactory.f90 LocStreamGeomFactory.F90 sourcefile~locstreamgeomfactory.f90->sourcefile~stringutilities.f90 sourcefile~meshgeomfactory_smod.f90 MeshGeomFactory_smod.F90 sourcefile~meshgeomfactory_smod.f90->sourcefile~stringutilities.f90 sourcefile~meshgeomspec_smod.f90 MeshGeomSpec_smod.F90 sourcefile~mesh