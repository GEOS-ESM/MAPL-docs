t) Arguments Type Intent Optional Attributes Name type( RoutehandleVectorIterator ), intent(in) :: it Return Value type( RoutehandleVectorIterator ) private  function vector_iter_next_n_size_kind(it, n) result(new_it) Arguments Type Intent Optional Attributes Name type( RoutehandleVectorIterator ), intent(in) :: it integer(kind=selected_int_kind(18)), intent(in) :: n Return Value type( RoutehandleVectorIterator ) private  function vector_iter_next_n_default(it, n) result(new_it) Arguments Type Intent Optional Attributes Name type( RoutehandleVectorIterator ), intent(in) :: it integer, intent(in) :: n Return Value type( RoutehandleVectorIterator )","tags":"","url":"interface/next~33.html"},{"title":"operator(+) – MAPL","text":"public interface operator(+) Module Procedures private  function vector_iter_a_plus_n_size_kind(a, n) result(new_iter) Arguments Type Intent Optional Attributes Name type( RoutehandleVectorIterator ), intent(in) :: a integer(kind=selected_int_kind(18)), intent(in) :: n Return Value type( RoutehandleVectorIterator ) private  function vector_iter_n_plus_a_size_kind(n, a) result(new_iter) Arguments Type Intent Optional Attributes Name integer(kind=selected_int_kind(18)), intent(in) :: n type( RoutehandleVectorIterator ), intent(in) :: a Return Value type( RoutehandleVectorIterator ) private  function vector_iter_n_plus_a_default(n, a) result(new_iter) Arguments Type Intent Optional Attributes Name integer, intent(in) :: n type( RoutehandleVectorIterator ), intent(in) :: a Return Value type( RoutehandleVectorIterator ) private  function vector_iter_a_plus_n_default(a, n) result(new_iter) Arguments Type Intent Optional Attributes Name type( RoutehandleVectorIterator ), intent(in) :: a integer, intent(in) :: n Return Value type( RoutehandleVectorIterator )","tags":"","url":"interface/operator(+)~17.html"},{"title":"operator(-) – MAPL","text":"public interface operator(-) Module Procedures private  function vector_iter_a_minus_n_size_kind(a, n) result