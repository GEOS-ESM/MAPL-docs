g , _ RC ) call add_child_ref_datetime ( child_hconfig , _ RC ) call add_stats_gc ( gridcomp , child_name , child_hconfig , _ RC ) call MAPL_GridCompAddChild ( gridcomp , child_name , user_setservices ( collection_setServices ), child_hconfig , timeStep = timeStep , _ RC ) end do _ RETURN ( _ SUCCESS ) end subroutine setServices","tags":"","url":"proc/setservices~12.html"},{"title":"String – MAPL","text":"public interface String Module Procedures private  function new_String(s) result(str) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: s Return Value type( String )","tags":"","url":"interface/string.html"},{"title":"CubedSphereDecomposition – MAPL","text":"public interface CubedSphereDecomposition Module Procedures private  interface new_CubedSphereDecomposition_basic() Arguments None private  interface new_CubedSphereDecomposition_petcount() Arguments None private  interface new_CubedSphereDecomposition_topo() Arguments None","tags":"","url":"interface/cubedspheredecomposition.html"},{"title":"make_CubedSphereDecomposition – MAPL","text":"public interface make_CubedSphereDecomposition Module Procedures private  interface make_CubedSphereDecomposition_current_vm() Arguments None private  interface make_CubedSphereDecomposition_vm() Arguments None","tags":"","url":"interface/make_cubedspheredecomposition.html"},{"title":"operator(/=) – MAPL","text":"public interface operator(/=) Module Procedures private  interface not_equal_to() Arguments None","tags":"","url":"interface/operator(SLASH=)~178.html"},{"title":"operator(==) – MAPL","text":"public interface operator(==) Module Procedures private  interface equal_to() Arguments None","tags":"","url":"interface/operator(==)~182.html"},{"title":"SeparatorColumn – MAPL","text":"public interface SeparatorColumn Module Procedures private  function new_SeparatorColumn(field) result(column) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: field Return Value type( Sep