lose ( unit = 999 , status = 'delete' , iostat = status ) end if end if _ RETURN ( _ SUCCESS ) end subroutine cleanup_test_file","tags":"","url":"proc/cleanup_test_file.html"},{"title":"create_eight_element_mesh_file – MAPL","text":"public  subroutine create_eight_element_mesh_file(filename, rc) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename integer, intent(out), optional :: rc Calls proc~~create_eight_element_mesh_file~~CallsGraph proc~create_eight_element_mesh_file create_eight_element_mesh_file none~add_attribute~3 Variable%add_attribute proc~create_eight_element_mesh_file->none~add_attribute~3 none~add_dimension FileMetadata%add_dimension proc~create_eight_element_mesh_file->none~add_dimension none~add_variable FileMetadata%add_variable proc~create_eight_element_mesh_file->none~add_variable none~create~5 NetCDF4_FileFormatter%create proc~create_eight_element_mesh_file->none~create~5 none~put_var~27 NetCDF4_FileFormatter%put_var proc~create_eight_element_mesh_file->none~put_var~27 proc~mapl_return MAPL_Return proc~create_eight_element_mesh_file->proc~mapl_return none~add_attribute_1d~2 Variable%add_attribute_1d none~add_attribute~3->none~add_attribute_1d~2 none~add_dimension->proc~mapl_return insert insert none~add_dimension->insert interface~mapl_assert MAPL_Assert none~add_dimension->interface~mapl_assert none~get_dimension~2 FileMetadata%get_dimension none~add_dimension->none~get_dimension~2 none~has_dimension FileMetadata%has_dimension none~add_dimension->none~has_dimension none~add_variable->proc~mapl_return at at none~add_variable->at begin begin none~add_variable->begin none~add_variable->interface~mapl_assert next next none~add_variable->next none~get_const_value Variable%get_const_value none~add_variable->none~get_const_value none~get_dimensions~4 Variable%get_dimensions none~add_variable->none~get_dimensions~4 none~get_shape UnlimitedEntity%get_shape none~add_variable->none~get_shape none~insert~305 StringVariabl