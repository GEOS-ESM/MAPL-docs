      type(MeterNodePtr), intent(in) :: value\n$      type (KeywordEnforcer), optional, intent(in) :: unused\n$      integer, optional, intent(out) :: rc\n$\n$      type(MeterNodePtr) :: temp\n$      integer(kind=GFTL_SIZE_KIND) :: i, n\n$\n$      if (.false.) print*,shape(unused)\n$\n$      n = this%vsize\n$      if (index==n+1) then\n$         call this%push_back(value)\n$         ! Workaround for NAG -6221 - temp needs some status\n$         temp=value\n$         return\n$      endif\n$      call this%grow_to(this%vsize+1)\n$      temp=this%elements(n)%item\n$      call this%resize(n+1, temp, rc=rc)\n$\n$      do i = n, index, -1\n$         this%elements(index)%item=this%elements(index-1)%item\n$      end do\n$\n$      this%elements(index)%item=value\n$\n$      return\n$   end subroutine vector_insert_size_kind\n$\n$\n$   subroutine vector_insert_default(this, index, value)\n$      class(MeterNodeStack), intent(inout) :: this\n$      integer, intent(in) :: index\n$      type(MeterNodePtr), intent(in) :: value\n$\n$      call this%insert(int(index,kind=GFTL_SIZE_KIND), value)\n$   end subroutine vector_insert_default Uses mapl_MeterNodePtr_mod module~~mapl_meternodestack_mod~~UsesGraph module~mapl_meternodestack_mod mapl_MeterNodeStack_mod module~mapl_meternodeptr_mod mapl_MeterNodePtr_mod module~mapl_meternodestack_mod->module~mapl_meternodeptr_mod module~mapl_abstractmeternode_mod mapl_AbstractMeterNode_mod module~mapl_meternodeptr_mod->module~mapl_abstractmeternode_mod module~mapl_abstractmeter_mod mapl_AbstractMeter_mod module~mapl_abstractmeternode_mod->module~mapl_abstractmeter_mod iso_fortran_env iso_fortran_env module~mapl_abstractmeter_mod->iso_fortran_env module~mapl_errorhandling_mod mapl_ErrorHandling_mod module~mapl_abstractmeter_mod->module~mapl_errorhandling_mod Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This