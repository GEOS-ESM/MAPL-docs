ibute ( config , value = KM_WORLD , Label = 'LM:' , rc = status ) !    _VERIFY(STATUS) call ESMF_ConfigGetAttribute ( config , value = nx , Label = 'NX:' , rc = status ) _ VERIFY ( STATUS ) call ESMF_ConfigGetAttribute ( config , value = ny , Label = 'NY:' , rc = status ) _ VERIFY ( STATUS ) print * , 'GRIDNAME=' , trim ( gridname ) print * , 'NX=' , nx print * , 'NX=' , nY !--------------------- !  CAP's MAPL MetaComp !--------------------- call MAPL_Set ( MAPL , name = 'CAP' , cf = CONFIG , rc = STATUS ) _ VERIFY ( STATUS ) ! grid create call MAPL_GridCreate ( MAPLOBJ = MAPL , ESMFGRID = grid , rc = status ) _ RETURN ( STATUS ) end function MyGridCreate_","tags":"","url":"proc/mygridcreate_~3.html"},{"title":"test_main – MAPL","text":"subroutine test_main() Arguments None Calls proc~~test_main~3~~CallsGraph proc~test_main~3 test_main ESMF_CalendarSetDefault ESMF_CalendarSetDefault proc~test_main~3->ESMF_CalendarSetDefault ESMF_ClockCreate ESMF_ClockCreate proc~test_main~3->ESMF_ClockCreate ESMF_Finalize ESMF_Finalize proc~test_main~3->ESMF_Finalize ESMF_Initialize ESMF_Initialize proc~test_main~3->ESMF_Initialize ESMF_TimeGet ESMF_TimeGet proc~test_main~3->ESMF_TimeGet ESMF_TimeIntervalSet ESMF_TimeIntervalSet proc~test_main~3->ESMF_TimeIntervalSet ESMF_TimeSet ESMF_TimeSet proc~test_main~3->ESMF_TimeSet ESMF_VMGetGlobal ESMF_VMGetGlobal proc~test_main~3->ESMF_VMGetGlobal esmf_fieldbundlecreate esmf_fieldbundlecreate proc~test_main~3->esmf_fieldbundlecreate esmf_fieldbundleset esmf_fieldbundleset proc~test_main~3->esmf_fieldbundleset interface~mapl_am_i_root MAPL_Am_I_Root proc~test_main~3->interface~mapl_am_i_root interface~mapl_cfioread MAPL_CFIORead proc~test_main~3->interface~mapl_cfioread interface~mapl_memutilswrite MAPL_MemUtilsWrite proc~test_main~3->interface~mapl_memutilswrite proc~mapl_memutilsinit MAPL_MemUtilsInit proc~test_main~3->proc~mapl_memutilsinit proc~mapl_verify MAPL_Verify proc~test_main~3->proc~mapl_verify proc~mygridcreate_~3 MyGridCreate_